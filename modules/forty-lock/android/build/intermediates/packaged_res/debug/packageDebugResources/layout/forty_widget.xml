<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/forty_widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/forty_widget_bg"
  android:orientation="vertical"
  android:padding="16dp">

  <TextView
    android:id="@+id/forty_widget_streak"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="FortyBible"
    android:textColor="#B8913A"
    android:textSize="13sp"
    android:textStyle="bold" />

  <TextView
    android:id="@+id/forty_widget_verse"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:layout_marginTop="6dp"
    android:ellipsize="end"
    android:fontFamily="serif"
    android:maxLines="5"
    android:textColor="#1A1A1A"
    android:textSize="15sp" />

  <TextView
    android:id="@+id/forty_widget_ref"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:textColor="#5C5648"
    android:textSize="12sp" />
</LinearLayout>
